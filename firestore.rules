rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to retrieve the user's role from their user document
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    // Helper function to check if the caller is an authorized administrator
    function isAdmin() {
      return isAuthenticated() && (getUserRole() == 'admin' || request.auth.token.admin == true);
    }

    // User profiles collection
    match /users/{userId} {
      // Any authenticated user can read their own profile; admins can read all
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      // Users can create their own profile during initial registration
      allow create: if isAuthenticated() && request.auth.uid == userId;
      // Only admins can change a user's role; users can update their display name or photo
      allow update: if isAuthenticated() && (
        isAdmin() || 
        (request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']))
      );
      allow delete: if isAdmin();
    }

    // Bus routes collection
    match /routes/{routeId} {
      // Anyone can read bus route schedules (students, teachers, commuters)
      allow read: if true;
      // Only authorized administrators can create, edit, or delete official bus routes
      allow create, update, delete: if isAdmin();
    }

    // Announcements collection
    match /announcements/{announcementId} {
      // All authenticated users can read announcements
      allow read: if isAuthenticated();
      // Only administrators can publish or delete transit advisories
      allow write: if isAdmin();
    }

    // User favorites and personal preferences
    match /users/{userId}/favorites/{routeId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    // System settings and theme
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
